# miniMDM environment configuration
# Copy this file to .env and adjust values for your environment

# PostgreSQL connection string
DATABASE_URL=postgresql://minimdm:minimdm@localhost:5432/minimdm

# Path to the miniMDM config file (YAML or JSON)
CONFIG_FILE=config/minimdm.yaml

# Application settings
APP_NAME=miniMDM
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000

# Authentication — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-long-random-string
TOKEN_EXPIRE_HOURS=8

# Set to true when serving over HTTPS (adds Secure flag to session cookie)
SECURE_COOKIE=false

# Set to true when running behind a trusted reverse proxy that sets X-Forwarded-For.
# When false (default), the direct TCP peer address is used for audit log IPs.
TRUSTED_PROXY=false

# Maximum file/body upload size in bytes (default 10 MB)
MAX_UPLOAD_SIZE=10485760

# Log format: "text" for human-readable (development), "json" for structured (production)
LOG_FORMAT=text

# Rate limiting (set to false in test environments)
RATE_LIMIT_ENABLED=true

# Auto-create first admin account on startup when no users exist (first run only)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-min-12-chars
